# Rename to .env to configure the LOCAL SIYAJ product.
# Never commit .env or share its contents.
# Strong local administrator token (if blank, generated in data/admin_token.txt).
ARG_ADMIN_TOKEN=
# Optional: real reference-agent model assessments (can incur API charges).
OPENAI_API_KEY=
# Local datastore. Imported synthetic fixtures are stored in plaintext SQLite.
ARG_DB_PATH=./data/redteam.sqlite3
# Optional: staging HTTP adapter bearer token; kept server-side only.
ARG_BRIDGE_TOKEN=
# Off by default. To allow a specific remote HTTPS STAGING agent, set both below.
ARG_ALLOW_REMOTE_TARGETS=0
ARG_ALLOWED_TARGET_HOSTS=
# Keep HTTP cookies local-only; set 1 only behind a correctly configured HTTPS proxy.
ARG_SECURE_COOKIE=0
